          👇 당신의 MBTI를 선택해주세요!
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 sm:gap-6">
        <!-- JS will render 16 MBTI Cards here -->
      </div>
    </section>

    <!-- Result Display Section -->
