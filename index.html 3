<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MBTI로 포켓몬 찾기</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Jua&family=Noto+Sans+KR:wght@400;600;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brandYellow: '#FFDE59',
            brandOrange: '#FF914D',
            brandCream: '#FFFDF0',
            brandCard: '#FFFFFF',
            brandText: '#2D3748',
          },
          fontFamily: {
            jua: ['Jua', 'sans-serif'],
            sans: ['Noto Sans KR', 'sans-serif'],
          },
          boxShadow: {
            poki: '0 10px 25px -5px rgba(255, 145, 77, 0.25), 0 8px 10px -6px rgba(255, 222, 89, 0.3)',
