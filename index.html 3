            <!-- Fallback Emoji Display (Hidden by default, shown on img error) -->
            <div id="resImageFallback" class="hidden text-8xl">⚡</div>

            <img 
              id="resPokemonImg" 
              src="" 
              alt="포켓몬 일러스트" 
              class="w-full h-full object-contain drop-shadow-xl transition-transform duration-300 group-hover:scale-105"
              onerror="handleImgError(this)"
            />
          </div>

          <div class="text-center">
            <span id="resPokemonDexNo" class="text-brandOrange font-bold text-lg block mb-0.5">No.025</span>
            <h3 id="resPokemonName" class="text-3xl sm:text-4xl font-jua text-gray-800">피카츄</h3>
          </div>
        </div>

        <!-- Pokémon Personality Match Reason -->
        <div class="bg-brandCream border-2 border-yellow-200 rounded-2xl p-5 sm:p-6 mb-8 shadow-sm">
          <h4 class="font-jua text-xl text-brandOrange mb-2 flex items-center gap-2">
            <i class="fa-solid fa-heart"></i> 어울리는 이유!
          </h4>
          <p id="resReason" class="text-base sm:text-lg text-gray-700 leading-relaxed font-medium">
            이유 설명이 들어갑니다.
          </p>
        </div>

        <!-- Best Compatibility Section -->
