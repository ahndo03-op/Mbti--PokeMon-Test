    // Render the grid of 16 MBTI cards
    function renderMbtiCards() {
      const selectionSection = id('selectionSection').querySelector('.grid');
      selectionSection.innerHTML = '';

      Object.keys(mbtiPokemonData).forEach(mbti => {
        const item = mbtiPokemonData[mbti];
        const cardHtml = `
          <button 
            onclick="selectMBTI('${mbti}')"
            class="card-bounce bg-white border-2 border-yellow-200 hover:border-brandOrange rounded-2xl p-4 text-center shadow-sm hover:shadow-poki transition-all duration-200 flex flex-col items-center justify-between group cursor-pointer active:scale-95"
          >
            <div class="w-full flex justify-between items-center mb-2">
              <span class="bg-yellow-100 text-brandOrange font-bold text-xs px-2.5 py-1 rounded-full group-hover:bg-brandOrange group-hover:text-white transition-colors">
                No.${item.formattedDex}
              </span>
              <i class="fa-solid fa-sparkles text-yellow-400 opacity-0 group-hover:opacity-100 transition-opacity"></i>
            </div>
            
            <div class="my-2">
              <h3 class="text-2xl font-jua text-gray-800 group-hover:text-brandOrange transition-colors">
                ${item.mbti}
              </h3>
              <p class="text-xs text-gray-500 font-medium mt-0.5">${item.title}</p>
            </div>

            <div class="mt-2 text-xs font-bold text-brandOrange bg-orange-50 w-full py-1.5 rounded-xl border border-orange-100 group-hover:bg-brandYellow group-hover:text-brandText transition-colors">
              ${item.pokemonName} 보기
            </div>
          </button>
        `;
        selectionSection.insertAdjacentHTML('beforeend', cardHtml);
      });
    }

    function selectMBTI(mbtiKey) {
      const data = mbtiPokemonData[mbtiKey];
      if (!data) return;

      const bestMatchData = mbtiPokemonData[data.bestMatch];

      // Populate Result Data
      id('resMbtiBadge').innerText = `${data.mbti} - ${data.title}`;
      id('resPokemonDexNo').innerText = `No.${data.formattedDex}`;
      id('resPokemonName').innerText = data.pokemonName;
      id('resReason').innerText = data.reason;

      // Handle main Pokémon image
      const resImg = id('resPokemonImg');
      const fallback = id('resImageFallback');
      fallback.classList.add('hidden');
      fallback.innerText = data.emojiFallback;
      resImg.classList.remove('hidden');
      resImg.src = getPokemonImgUrl(data.dexNo);

      // Populate Best Match Card
      id('matchMbti').innerText = bestMatchData.mbti;
      id('matchDexNo').innerText = `No.${bestMatchData.formattedDex}`;
      id('matchName').innerText = bestMatchData.pokemonName;
      id('matchDesc').innerText = `${bestMatchData.title} (${bestMatchData.pokemonName})`;
      
      const matchImg = id('matchImg');
      matchImg.src = getPokemonImgUrl(bestMatchData.dexNo);

      // Store MBTI for clickable match card
      id('bestMatchCard').dataset.mbti = bestMatchData.mbti;

      // Toggle views smoothly
      id('selectionSection').classList.add('hidden');
      id('resultSection').classList.remove('hidden');

      // Scroll to top of result
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Reset Selection
    function resetSelection() {
      id('resultSection').classList.add('hidden');
      id('selectionSection').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Helper functions
    function id(elementId) {
      return document.getElementById(elementId);
    }

    // Image fallback handling if CDN image fails
    function handleImgError(img) {
      img.classList.add('hidden');
      const fallback = id('resImageFallback');
      if (fallback && img.id === 'resPokemonImg') {
        fallback.classList.remove('hidden');
      }
    }

    // Initialize application on load
    window.onload = function() {
      renderMbtiCards();
    };
  </script>
</body>
</html>
